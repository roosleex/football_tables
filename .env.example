# football-data.org API key — register at https://www.football-data.org/client/register
# Leave empty to serve the bundled demo data.
FOOTBALL_DATA_API_KEY=

# Maximum football-data.org requests per minute (free tier: 10).
MAX_REQUESTS_PER_MINUTE=10

# Hide competitions from the menu (JSON list of football-data.org codes).
# The default already removes the Championship ("ELC").
# EXCLUDED_LEAGUE_CODES=["ELC"]

# openfootapi.com API key — get one at https://openfootapi.com (key starts with "of_live_").
# Leave empty to skip openfootapi leagues.
OPENFOOT_API_KEY=

# openfootapi.com free tier rate limit (60 requests/minute).
FOOTAPI_MAX_REQUESTS_PER_MINUTE=60

# api-football.com (API-Sports) key — register at https://www.api-football.com
# Leave empty to skip the Czech First League (sourced from api-football.com).
APIFOOTBALL_API_KEY=

# Make one api-football.com request every N minutes.
APIFOOTBALL_ONEREQ_EVERY_MINUTES=15

# api-football.com league id for the Czech First League.
APIFOOTBALL_CZECH_LEAGUE_ID=345